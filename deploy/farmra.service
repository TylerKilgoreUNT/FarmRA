[Unit]
Description=Farmra Flask App
After=network.target

[Service]
User=developer
Group=developer
WorkingDirectory=/home/developer/FarmRA-Backend
Environment="PATH=/home/developer/FarmRA-Backend/venv/bin"
ExecStart=/home/developer/FarmRA-Backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target